#!/bin/sh

# ------------------------------------------------------------------
# 1. Branch Protection Check
# ------------------------------------------------------------------
protected_branch='main'
current_branch=$(git rev-parse --abbrev-ref HEAD)

if [ "$current_branch" = "$protected_branch" ]; then
    echo ""
    printf "\033[0;31m[ERROR] Direct commits to '%s' are not allowed!\033[0m\n" "$protected_branch"
    echo "Please create and switch to a feature branch first:"
    echo "  git checkout -b feature/your-feature-name"
    echo ""
    exit 1
fi

echo "=================================================="
echo " Running Pre-Commit Quality Checks (42 Rules)"
echo "=================================================="

# Activate virtual environment if available
if [ -f ".venv/bin/activate" ]; then
    . .venv/bin/activate
fi

PYTHON_CMD="python3"
if [ -f ".venv/bin/python" ]; then
    PYTHON_CMD=".venv/bin/python"
fi

# ------------------------------------------------------------------
# 2. Check Python 3.10+ Requirement
# ------------------------------------------------------------------
echo "[1/3] Checking Python version (>= 3.10)..."
$PYTHON_CMD -c "import sys; exit(0 if sys.version_info >= (3, 10) else 1)" 2>/dev/null
if [ $? -ne 0 ]; then
    printf "\033[0;31m[FAIL] Python 3.10 or higher is required!\033[0m\n"
    exit 1
fi

# ------------------------------------------------------------------
# 3. Flake8 Style & PEP 257 Docstring Check
# ------------------------------------------------------------------
FLAKE8_CMD="flake8"
if [ -f ".venv/bin/flake8" ]; then
    FLAKE8_CMD=".venv/bin/flake8"
fi

if command -v $FLAKE8_CMD >/dev/null 2>&1; then
    echo "[2/3] Running flake8 (PEP 8 & PEP 257 docstring checks)..."
    $FLAKE8_CMD . --exclude=.venv
    if [ $? -ne 0 ]; then
        printf "\033[0;31m[FAIL] flake8 checks failed! Please fix coding style and PEP 257 docstring errors.\033[0m\n"
        exit 1
    fi
else
    printf "\033[0;33m[WARN] flake8 not found. Run 'make install' to set up linting tools.\033[0m\n"
fi

# ------------------------------------------------------------------
# 4. Mypy Type Hint Checking
# ------------------------------------------------------------------
MYPY_CMD="mypy"
if [ -f ".venv/bin/mypy" ]; then
    MYPY_CMD=".venv/bin/mypy"
fi

if command -v $MYPY_CMD >/dev/null 2>&1; then
    echo "[3/3] Running mypy static type checking..."
    $MYPY_CMD . --warn-return-any --warn-unused-ignores --ignore-missing-imports --disallow-untyped-defs --check-untyped-defs
    if [ $? -ne 0 ]; then
        printf "\033[0;31m[FAIL] mypy static type checks failed! Ensure all functions have proper type hints.\033[0m\n"
        exit 1
    fi
else
    printf "\033[0;33m[WARN] mypy not found. Run 'make install' to set up static type checking.\033[0m\n"
fi

printf "\033[0;32m[SUCCESS] All pre-commit checks passed!\033[0m\n"
